{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safe-counter/proposal_response.json",
  "title": "AI scribe response",
  "description": "Shape of every response from the AI scribe. A response that matches this shape is not necessarily correct or allowed: scope, permissions, units and sensitivity are for your server to check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "proposals", "abstentions", "flags"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "field", "value", "unit", "confidence", "evidence", "sensitivity", "reason"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "field": {"type": "string", "minLength": 1, "description": "entity.field, e.g. rental.returned_at"},
          "value": {"type": ["string", "integer"]},
          "unit": {"type": "string", "enum": ["iso8601", "enum", "days", "pence", "text", "e164", "email"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "string", "minLength": 1, "description": "Words quoted from the note that support the value."},
          "sensitivity": {"type": "string", "enum": ["normal", "sensitive"], "description": "The AI's own label. Never trust it: the server decides."},
          "reason": {"type": "string"}
        }
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "field", "reason"],
        "properties": {
          "record_id": {"type": "string"},
          "field": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "detail"],
        "properties": {
          "type": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
